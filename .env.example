# Required. Secret used to sign in as your bot.
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Required. Public application ID, also called the Client ID.
# Discord Developer Portal -> your application -> General Information
DISCORD_CLIENT_ID=

# Optional. Server ID used for instant command registration during development.
# Leave empty for global commands, which can take up to an hour to appear.
# In Discord: User Settings -> Advanced -> Developer Mode, then right-click server -> Copy ID.
DISCORD_GUILD_ID=

# Optional. yt-dlp executable name or absolute path.
YTDLP_PATH=yt-dlp

# Optional. Maximum tracks accepted from one YouTube playlist. Minimum: 1.
MAX_PLAYLIST_SIZE=100

# Optional. Seconds to remain connected after the queue ends. Minimum: 10.
IDLE_DISCONNECT_SECONDS=300
